# ============================================================
# Financial RAG — .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---------- Virtual Environments ----------
.venv/
venv/
env/
ENV/
.python-version

# ---------- Environment Variables & Secrets ----------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
secrets/
credentials.json
service-account*.json

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- IDEs ----------
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
*~

# ---------- Operating System ----------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Financial RAG: Private Source Documents ----------
# Keep original annual reports and user-uploaded financial reports private.
data/raw/
data/user_uploads/
uploads/
private_data/
*.pdf
*.PDF

# ---------- Financial RAG: Generated Processing Data ----------
# Extraction outputs, chunks, inventories and reports can be regenerated.
data/processed/
data/interim/
data/cache/
data/tmp/
*.jsonl
*.pkl
*.pickle
*.npy
*.npz
*.parquet
*.feather

# ---------- Embeddings & Vector Indexes ----------
*.index
*.faiss
*.bin
*.safetensors
*.onnx
embeddings/
indexes/
vector_store/
chroma_db/
chroma.sqlite3

# ---------- Model Weights & Caches ----------
models/
checkpoints/
.cache/
huggingface_cache/
sentence_transformers_cache/

# ---------- Logs & Temporary Files ----------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.old
*.orig

# ---------- Test & Coverage ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.nox/
.tox/

# ---------- React / Node.js (future frontend) ----------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.npm/

# ---------- React Environment Variables ----------
frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.template

# ---------- FastAPI / Runtime ----------
instance/
static/uploads/
media/uploads/
*.pid
gunicorn.log

# ---------- Database & Local Runtime Data ----------
*.db
*.sqlite
*.sqlite3
database/
backups/
*.dump
*.sql.gz

# ---------- Local Configuration ----------
config.local.*
settings.local.*
